query IT nosort
SELECT CAST('123' AS INTEGER), typeof(CAST('123' AS INTEGER))
----
123
integer

query III nosort
SELECT CAST('12.5' AS INTEGER), CAST('abc' AS INTEGER), CAST('12.7' AS INTEGER)
----
12
0
12

query III nosort
SELECT CAST('-12.7' AS INTEGER), CAST(' 42 ' AS INTEGER), CAST('4.2e1' AS INTEGER)
----
